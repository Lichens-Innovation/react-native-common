{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "ignoreDeprecations": "6.0",
    "declarationDir": "dist",
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "moduleResolution": "bundler",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "..",
    "paths": {
      "~/*": ["./src/*"],
      "@lichens-innovation/ts-common/*": ["../ts-common/src/*"],
      "@lichens-innovation/ts-common": ["../ts-common/src"],
      "i18next": ["./node_modules/i18next"]
    },
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ES2017"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx", "vitest.config.ts"]
}
